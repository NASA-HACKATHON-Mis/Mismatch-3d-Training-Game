; 달기지 리와인드 — Godot 4.7.2
config_version=5

[application]
config/name="Lunar Base Rewind"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]
window/size/viewport_width=1280
window/size/viewport_height=800
window/size/window_width_override=1152
window/size/window_height_override=720
window/stretch/mode="disabled"

[input]
base_map={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":52), Object(InputEventKey,"keycode":52)]
}
site_edit={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":49), Object(InputEventKey,"keycode":49)]
}
site_details={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":50), Object(InputEventKey,"keycode":50)]
}
site_inspect={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":51), Object(InputEventKey,"keycode":51)]
}
jump={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":32), Object(InputEventKey,"keycode":32)]
}
walk_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":65), Object(InputEventKey,"keycode":65)]
}
walk_right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":68), Object(InputEventKey,"keycode":68)]
}
walk_forward={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":87), Object(InputEventKey,"keycode":87)]
}
walk_back={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":83), Object(InputEventKey,"keycode":83)]
}
open_terminal={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":69), Object(InputEventKey,"keycode":69)]
}

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.025, 0.037, 0.062, 1)
